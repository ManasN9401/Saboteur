# AI providers (server-side only; never exposed to the browser). Set any you have: the router
# (docs/router.md) uses every provider with a key, learns which models work, and fails over between
# them. Numbered copies (_2, _3) are separate keys with their own rate limits.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GEMINI_API_KEY=
NVIDIA_API_KEY=
LLM7_API_KEY=
COHERE_API_KEY=
KILO_API_KEY=

# Extra routes by hand, comma-separated: provider:model:capability(1-5)[:vision]
# SABOTEUR_ROUTES=groq:qwen/qwen3-32b:3
# A provider's endpoint can be moved with <NAME>_BASE_URL, e.g. KILO_BASE_URL=https://…/v1

# Set to 1 to play with canned rounds and no API calls (photosynthesis, water cycle, WW1).
SABOTEUR_MOCK=0

# Server-side refusal fallback on the Sonnet calls. Set to 0 if your platform doesn't support it.
SABOTEUR_FALLBACKS=1

# Set to 0 to replace the stamp footage on the reveal screen with the coded animation.
NEXT_PUBLIC_STAMP_VIDEO=1

# Set to "offline" to build rounds with rules only, even when an API key is present.
# (Offline mode also switches on by itself when no key is set or the AI can't be reached.)
SABOTEUR_ENGINE=

# ---- Security and abuse limits (docs/deploy.md) ----
# AI calls this server may make per day, across everyone. Past it, rounds are built offline.
AI_DAILY_BUDGET=2000
# Multiplies every per-client rate limit (lib/security/limits.ts): 10 for load tests, 0.5 under attack.
RATE_LIMIT_SCALE=1
# The header your host puts the visitor's real address in, e.g. fly-client-ip, cf-connecting-ip, x-real-ip.
# Unset: the right-most X-Forwarded-For entry (set TRUST_PROXY_HOPS if you chain several proxies).
TRUSTED_IP_HEADER=
TRUST_PROXY_HOPS=1
# Other sites allowed to call the API (comma-separated origins). Normally empty.
ALLOWED_ORIGINS=
# In production /api/health (which spends a model call) answers only with this token in x-health-token.
HEALTH_TOKEN=
